# PlatformIO build output
.pio/
.pioenvs/
.piolibdeps/

# Python caches / local env
__pycache__/
*.py[cod]
.venv/
*.egg-info/

# VS Code local state (tasks.json/extensions.json are committed)
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch

# Generated build / design artifacts
pc/dist/
dist/
pc/mockups/
mockups/
backup/

# User data and local state (never commit)
user-data/
learning.json
calibration.json
onboarding.json
keybindings.json
accessibility.json
score_prefs.json
library_meta.json
logs/
*.log
*.tmp
*.bak

# Local hardware traces
tools/*.txt
pc/prototype/logs/

# Private content / third-party reference images (never public history)
pc/resources/scores/mariage_fragment.*
ESP32-S3_DevKitC-1_pinlayout_v1.1.jpg
