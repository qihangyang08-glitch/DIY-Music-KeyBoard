  "prerequisites": ["s4-l4"],
  "duration_min": 6,
  "blocks": [
    {
      "id": "s4-l5-b1",
      "type": "text",
      "title": "分解和弦型",
      "body": "分解和弦把和弦音依次弹出。4/4 常用根音–五度–八度–五度（1-5-8-5），也有 1-3-5-3。以 C 为例：C–G–C–G 或 C–E–G–E。先慢速把四个音分匀，再加速。"
    },
    {
      "id": "s4-l5-b2",
      "type": "text",
      "title": "手腕带动",
      "body": "分解和弦不是四个手指各自乱动；用手腕轻微带动，手指保持弧形。低音稍重，后面三个音轻一点。每一组四音占一拍或两拍，按谱面时值来。"
    },
    {
      "id": "s4-l5-demo",
      "type": "demo",
      "score": "arpeggio_4_4",
      "tempo": 60,
      "caption": "示范要点：听 1-5-8-5 四音一组，是否均匀。"
    },
    {
      "id": "s4-l5-steps",
      "type": "steps",
      "title": "练习步骤",
      "items": [
        "左手慢速弹 C–G–C–G，四音一组。",
        "换 1-3-5-3：C–E–G–E。",
        "打开「分解和弦 · 4/4」跟弹 8 小节。"
      ]
    }
  ],
  "check": [
    {"question": "四个音均匀吗？", "type": "self"},
    {"question": "低音是否稍突出？", "type": "self"},
    {"question": "手腕保持放松吗？", "type": "self"}
  ],
  "mistakes": [
    "四个音一样重——没有低音骨架。",
    "手指僵硬——速度上不去。"
  ],
