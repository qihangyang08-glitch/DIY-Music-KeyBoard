  "duration_min": 5,
  "blocks": [
    {
      "id": "s5-l7-b1",
      "type": "text",
      "title": "只练困难小节",
      "body": "不要每次从头弹。把最难的 1–2 小节圈出来，单独循环 5–10 遍，速度从 50% 开始。稳定后再把前后各一小节接进来。"
    },
    {
      "id": "s5-l7-b2",
      "type": "text",
      "title": "循环不是机械重复",
      "body": "每遍都要听同一个问题：错音、节奏、指法还是手位。改一个点，再循环。如果连续 3 遍都对，才加速或扩大范围。"
    },
    {
      "id": "s5-l7-demo",
      "type": "demo",
      "score": "fixed_accompaniment",
      "tempo": 50,
      "caption": "示范要点：听困难小节单独循环，再听它与前后连接。"
    },
    {
      "id": "s5-l7-steps",
      "type": "steps",
      "title": "练习步骤",
      "items": [
        "圈出最难的 1–2 小节。",
        "50% 速度循环 5 遍，每遍只改一个问题。",
        "接上前一小节与后一小节，再循环 3 遍。"
      ]
    }
  ],
